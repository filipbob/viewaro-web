# TLS vhost for the Tvheadend review demo (tvh.viewaro.itquotes.hr).
#
# Activate after certbot has issued the certificate (see deploy/README.md):
#   cp deploy/nginx/tvh.conf.tls-template deploy/nginx/tvh.conf
#   docker exec viewaro-web nginx -t && docker exec viewaro-web nginx -s reload
#
# Only the paths Viewaro's Tvheadend client uses are forwarded; everything
# else, including Tvheadend's web UI and every write endpoint, is a 404 here.
# Authentication stays with Tvheadend (Basic and Digest), so the request URI
# is passed through byte for byte: Digest signs it.

# http-level names must be unique across every file in this directory, or
# nginx refuses to start ("duplicate log_format", "zone already bound").
limit_req_zone $binary_remote_addr zone=tvh_demo:10m rate=5r/s;

# Own log without the query string, and not the shared access.log: fail2ban
# parses that one with the combined format.
log_format tvh_demo_no_query '$remote_addr - $remote_user [$time_local] '
                             '"$request_method $uri $server_protocol" '
                             '$status $body_bytes_sent "$http_user_agent" $request_time';

server {
    listen 80;
    listen [::]:80;
    server_name tvh.viewaro.itquotes.hr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name tvh.viewaro.itquotes.hr;

    ssl_certificate     /etc/letsencrypt/live/tvh.viewaro.itquotes.hr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tvh.viewaro.itquotes.hr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    access_log /var/log/nginx/tvh.access.log tvh_demo_no_query;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Resolved per request through Docker's DNS, so nginx still starts when
    # the tvheadend-demo stack is down; server-level, so it does not clash
    # with the http-level resolver in pausal.conf.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $tvh http://tvheadend-demo:9981;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;

    location = /api/serverinfo      { limit_except GET { deny all; } limit_req zone=tvh_demo burst=20 nodelay; proxy_pass $tvh$request_uri; }
    location = /api/profile/list    { limit_except GET { deny all; } limit_req zone=tvh_demo burst=20 nodelay; proxy_pass $tvh$request_uri; }
    location = /api/channeltag/grid { limit_except GET { deny all; } limit_req zone=tvh_demo burst=20 nodelay; proxy_pass $tvh$request_uri; }
    location = /api/channel/grid    { limit_except GET { deny all; } limit_req zone=tvh_demo burst=20 nodelay; proxy_pass $tvh$request_uri; }
    location = /xmltv/channels      { limit_except GET { deny all; } limit_req zone=tvh_demo burst=20 nodelay; proxy_pass $tvh$request_uri; }

    # Live MPEG-TS: no buffering, and long timeouts so a stream is not cut.
    location ^~ /stream/channel/ {
        limit_except GET { deny all; }
        proxy_pass $tvh$request_uri;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        return 404;
    }
}
